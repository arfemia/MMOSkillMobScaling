command.inspect.difficulty = Dificultad efectiva de aparición aquí: {difficulty}
command.inspect.chance = Probabilidad de rareza al aparecer: {chance}
command.inspect.player_scaling = Escalado por jugadores: {applied} (activado: {enabled}, anillo inicial: {ring} bloques, dentro del anillo: {inRing}, distancia al punto de aparición: {distance})
