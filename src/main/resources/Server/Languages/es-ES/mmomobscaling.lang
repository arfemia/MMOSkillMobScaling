command.desc = Herramientas de administración del escalado de criaturas: purgar residuos, inspeccionar la dificultad local, ajustar las superposiciones del HUD.
command.arg.sub = Subcomando: purge elimina los residuos de escalado de las criaturas cargadas; inspect muestra los valores de dificultad en tu posición; hud ajusta las superposiciones; preset cambia el preset activo; worlds lista los archivos de configuración por mundo; ui abre la página de configuración del administrador.
command.usage = Uso: /mobscaling <purge|inspect|hud|preset|worlds|ui>
