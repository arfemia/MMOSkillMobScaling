$C = "../Common.ui";
$F = "../Common/ZigFrames.ui";
$Z = "../Common/ZigButtons.ui";

// MMO Mob Scaling admin config page (com.ziggfreed.mmomobscaling.pages.MobScalingAdminPage).
// SPEC-DRIVEN: every knob row (Global / Zone HUD / Inspector HUD / Worlds / Floors) is appended at
// runtime by the shared ziggfreed-common ui/form engine (Pages/ZigForm*Row.ui) from a Java FieldSpec
// list - this file only lays out the STATIC shell (title, tabs, the five scrolling form containers, the
// two-panel Worlds and Floors tabs, save/new/clear buttons, the status line) plus the ONE hand-built row
// that cannot be a FieldSpec (the preset dropdown, whose entries are dynamic) and the Global tab's
// hand-built preview column (nothing there is a leaf to persist). Every #Mmoscaling* id is mod-prefixed
// (the client UI namespace is flat + cross-mod). ALL display text is pushed from Java on .TextSpans
// (never .Text) as client-resolved Messages. EVERY labelled button is a RICH ZigRichButton (a Button
// + inner #Label, label set via ZigRichButton.text) - NEVER a TextButton.Text sink. Smoke-test in-game
// (.ui is not gradle-validated).

// ---- local styles / templates ----
@DropStyle = DropdownBoxStyle(
  ...$C.@DefaultDropdownBoxStyle,
  LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, TextColor: #ffffff, RenderUppercase: false)
);
@HeaderStyle = (FontSize: 15, TextColor: #ffaa4a, RenderBold: true, VerticalAlignment: Center);
@RowLabelStyle = (FontSize: 13, TextColor: #cdd8e6, VerticalAlignment: Center);
// The preview column's section titles and wrapping notes (the skeleton preview, the ladder, the MMO side).
@PreviewTitleStyle = (FontSize: 15, TextColor: #ffaa4a, RenderBold: true);
@PreviewNoteStyle = (FontSize: 11, TextColor: #8696a8, Wrap: true);
@PreviewLineStyle = (FontSize: 12, TextColor: #cdd8e6, Wrap: true);

// A label + control row (used only by the hand-built preset row and the difficulty probe - every other
// row comes from the shared ziggfreed-common ui/form row templates).
@Row = Group {
  LayoutMode: Left;
  Anchor: (Height: 32, Bottom: 5);
};

// The ONE rich button (Button backgrounds + click sounds + a centered inner #Label pushed via
// .TextSpans). Used for tabs and every save / new / clear button - ZigRichButton.text sets the label,
// SettingsUiUtil.setToggle / setTabActive drive the state. @Style overridable per instance.
@RichBtn = Button {
  @Style = $Z.@ZigRichRowBtnStyle;
  Style: @Style;
  Anchor: (Height: 30);
  Label #Label {
    FlexWeight: 1;
    Text: "";
    Style: (FontSize: 13, TextColor: #e6eef7, HorizontalAlignment: Center, VerticalAlignment: Center);
  }
};

// A section header line (used only for the static world / floor editor headers - every per-knob header
// comes from the shared ZigFormHeaderRow.ui template).
@Header = Label {
  Text: "";
  Anchor: (Height: 24, Top: 6, Bottom: 4);
  Style: @HeaderStyle;
};

// A scrolling list container (the four spec-driven forms, the two CRUD lists).
@ScrollList = Group {
  FlexWeight: 1;
  LayoutMode: TopScrolling;
  ScrollbarStyle: $C.@DefaultScrollbarStyle;
  Padding: (Right: 4);
};

// The "nothing here yet" line under a CRUD list.
@EmptyLine = Label {
  Text: "";
  Visible: false;
  Anchor: (Height: 20, Top: 4, Bottom: 4);
  Style: (FontSize: 12, TextColor: #8696a8, HorizontalAlignment: Center);
};

$C.@PageOverlay {}

$F.@ZigDecoratedFrame {
  @CloseButton = true;
  Anchor: (Width: 960, Height: 680);

  #Content {
    Label #MmoscalingTitle {
      Text: "";
      Anchor: (Height: 28, Bottom: 6);
      Style: (FontSize: 20, TextColor: #ffd97a, RenderBold: true);
    }

    // Tab bar (rich buttons; active tab tinted from Java via SettingsUiUtil.setTabActive).
    Group #MmoscalingTabBar {
      LayoutMode: Left;
      Anchor: (Height: 32, Bottom: 8);
      @RichBtn #MmoscalingTabGlobal    { FlexWeight: 1; Anchor: (Height: 32); }
      @RichBtn #MmoscalingTabZoneHud   { FlexWeight: 1; Anchor: (Height: 32, Left: 5); }
      @RichBtn #MmoscalingTabInspector { FlexWeight: 1; Anchor: (Height: 32, Left: 5); }
      @RichBtn #MmoscalingTabWorlds    { FlexWeight: 1; Anchor: (Height: 32, Left: 5); }
      @RichBtn #MmoscalingTabFloors    { FlexWeight: 1; Anchor: (Height: 32, Left: 5); }
    }

    // The tab body: exactly one section is Visible at a time.
    Group #MmoscalingBody {
      FlexWeight: 1;
      LayoutMode: Top;

      // ================= GLOBAL (two-panel: settings left, the live preview column right) =================
      Group #MmoscalingSectionGlobal {
        FlexWeight: 1;
        LayoutMode: Left;

        // ---- LEFT: static preset row, the scrolling spec-driven form, a static Save button ----
        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          @Row {
            Label #MmoscalingPresetLabel { FlexWeight: 1; Text: ""; Style: @RowLabelStyle; }
            $C.@DropdownBox #MmoscalingPresetDropdown { Anchor: (Width: 200, Height: 30); Style: @DropStyle; }
          }

          @ScrollList #MmoscalingGlobalForm {}

          @RichBtn #MmoscalingGlobalSave { @Style = $Z.@ZigRichPrimaryBtnStyle; Anchor: (Height: 32, Top: 6); }
        }

        // Thin vertical separator (matches the Worlds tab's list/editor divider).
        Group { Anchor: (Width: 1, Left: 8, Right: 8); Background: #1e2a36; }

        // ---- RIGHT: the preview column, SCROLLING (it outgrows the frame once the ladder and the MMO
        // panel are on it). A plain Skeleton through the difficulty stat curve on the left, exactly as
        // the spawn fold would run it; a rarity or variant reads the same curve further along, which is
        // what the ladder shows. Refreshed from Java on every Global-tab field/press/save/preset event
        // (MobScalingAdminPage.refreshPreview); the probe's own event repaints only the probe row and
        // the ladder (refreshProbeAndLadder).
        Group {
          Anchor: (Width: 300);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 10, Right: 4);

          Label #MmoscalingPreviewTitle {
            Text: "";
            Anchor: (Height: 22, Bottom: 4);
            Style: @PreviewTitleStyle;
          }
          Label #MmoscalingPreviewNote {
            Text: "";
            Anchor: (Bottom: 8);
            Style: @PreviewNoteStyle;
          }
          // Five appended Pages/MmoscalingPreviewRow.ui rows (two wrapping lines each): the samples.
          Group #MmoscalingPreviewList {
            LayoutMode: Top;
          }

          // Manual difficulty probe: type any difficulty >= 1 to preview it directly, UNCLAMPED to the
          // live Min/Max cap band (the curve's own rails still bound the resulting factors) - wired
          // OUTSIDE the spec-driven form, own "previewD" ValueChanged event
          // (MobScalingAdminPage.buildPreviewPanel/handlePreviewDifficulty). #MmoscalingProbeList holds
          // ONE appended preview row and is shown only while the field holds a parseable difficulty; the
          // ladder below follows the same number.
          @Row {
            Anchor: (Height: 30, Top: 6, Bottom: 0);
            Label #MmoscalingPreviewCustomLabel { FlexWeight: 1; Text: ""; Style: @RowLabelStyle; }
            $C.@TextField #MmoscalingPreviewCustomField { Anchor: (Width: 80, Height: 28); Padding: (Horizontal: 8); }
          }
          Group #MmoscalingProbeList {
            LayoutMode: Top;
            Visible: false;
            Anchor: (Top: 4);
          }

          // The rarity ladder at the probed difficulty (the baseline floor while nothing is typed): one
          // appended preview row per rung, the plain mob first, then every folded tier weakest to
          // strongest. Cleared + re-appended on every refresh (no bindings to redo).
          Label #MmoscalingLadderTitle {
            Text: "";
            Anchor: (Height: 22, Top: 10, Bottom: 4);
            Style: @PreviewTitleStyle;
          }
          Label #MmoscalingLadderNote {
            Text: "";
            Anchor: (Bottom: 8);
            Style: @PreviewNoteStyle;
          }
          Group #MmoscalingLadderList {
            LayoutMode: Top;
          }

          // The MMO side, READ ONLY: the player power floor and ceiling this mod can read through the
          // frozen MMOSkillTreeAPI (or one line saying it cannot), the viewing admin's own power, how the
          // form's Min/Max caps sit against them, and where those numbers are edited. Nothing here writes
          // an MMO file. (MobScalingAdminPage.buildMmoPanel / refreshMmoCapLine.)
          Label #MmoscalingMmoTitle {
            Text: "";
            Anchor: (Height: 22, Top: 10, Bottom: 4);
            Style: @PreviewTitleStyle;
          }
          Label #MmoscalingMmoPower {
            Text: "";
            Anchor: (Bottom: 4);
            Style: @PreviewLineStyle;
          }
          Label #MmoscalingMmoOwnPower {
            Text: "";
            Visible: false;
            Anchor: (Bottom: 4);
            Style: @PreviewLineStyle;
          }
          Label #MmoscalingMmoCap {
            Text: "";
            Visible: false;
            Anchor: (Bottom: 6);
            Style: @PreviewLineStyle;
          }
          Label #MmoscalingMmoWhere {
            Text: "";
            Anchor: (Bottom: 8);
            Style: @PreviewNoteStyle;
          }
        }
      }

      // ================= ZONE HUD =================
      Group #MmoscalingSectionZoneHud {
        Visible: false;
        FlexWeight: 1;
        LayoutMode: Top;

        @ScrollList #MmoscalingZoneForm {}

        @RichBtn #MmoscalingZoneSave { @Style = $Z.@ZigRichPrimaryBtnStyle; Anchor: (Height: 32, Top: 6); }
      }

      // ================= INSPECTOR HUD =================
      Group #MmoscalingSectionInspector {
        Visible: false;
        FlexWeight: 1;
        LayoutMode: Top;

        @ScrollList #MmoscalingInspectorForm {}

        @RichBtn #MmoscalingInspectorSave { @Style = $Z.@ZigRichPrimaryBtnStyle; Anchor: (Height: 32, Top: 6); }
      }

      // ================= WORLDS (two-panel: list left, add/edit editor right) =================
      Group #MmoscalingSectionWorlds {
        Visible: false;
        FlexWeight: 1;
        LayoutMode: Left;

        // ---- LEFT: the world list ----
        Group {
          Anchor: (Width: 300);
          LayoutMode: Top;

          // Appended per-world rows (Pages/MmoscalingWorldRow.ui, a mod-local wrapping row - not the
          // common ZigListRow): #Title = id (wraps to two lines), #Sub = summary, #Badge =
          // shipped/override, rich #EditBtn / #RemoveBtn.
          @ScrollList #MmoscalingWorldList {}
          @EmptyLine #MmoscalingWorldEmpty {}
          @RichBtn #MmoscalingWorldNew { Anchor: (Height: 32, Top: 6); }
        }

        // Thin vertical separator between the list and the editor.
        Group { Anchor: (Width: 1, Left: 8, Right: 8); Background: #1e2a36; }

        // ---- RIGHT: add / edit editor ----
        // Blank fields / the Inherit dropdown option inherit the Parent chain then the global fold.
        // The three Where fields and the pool allow/deny lists are comma-separated (deny wins).
        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          @Header #MmoscalingWorldEditorHeader {}

          @ScrollList #MmoscalingWorldForm {}

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 6);
            @RichBtn #MmoscalingWorldSave  { @Style = $Z.@ZigRichPrimaryBtnStyle; FlexWeight: 1; Anchor: (Height: 32); }
            @RichBtn #MmoscalingWorldClear { FlexWeight: 1; Anchor: (Height: 32, Left: 6); }
          }
        }
      }

      // ================= FLOORS (two-panel: the zone / biome floor list left, add/edit editor right) =================
      // The same shape as Worlds, on the same row template: every folded Difficulty/*.json mapping,
      // shipped or owner-authored, and an editor whose blank fields inherit the shipped mapping per leaf.
      Group #MmoscalingSectionFloors {
        Visible: false;
        FlexWeight: 1;
        LayoutMode: Left;

        // ---- LEFT: the floor list ----
        Group {
          Anchor: (Width: 300);
          LayoutMode: Top;

          // Appended per-mapping rows (Pages/MmoscalingWorldRow.ui): #Title = the mapping id, #Sub = its
          // target and floor, #Badge = shipped/override, rich #EditBtn / #RemoveBtn (owner files only).
          @ScrollList #MmoscalingFloorList {}
          @EmptyLine #MmoscalingFloorEmpty {}
          @RichBtn #MmoscalingFloorNew { Anchor: (Height: 32, Top: 6); }
        }

        // Thin vertical separator between the list and the editor.
        Group { Anchor: (Width: 1, Left: 8, Right: 8); Background: #1e2a36; }

        // ---- RIGHT: add / edit editor ----
        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          @Header #MmoscalingFloorEditorHeader {}

          @ScrollList #MmoscalingFloorForm {}

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 6);
            @RichBtn #MmoscalingFloorSave  { @Style = $Z.@ZigRichPrimaryBtnStyle; FlexWeight: 1; Anchor: (Height: 32); }
            @RichBtn #MmoscalingFloorClear { FlexWeight: 1; Anchor: (Height: 32, Left: 6); }
          }
        }
      }
    }

    Label #MmoscalingStatus {
      Text: "";
      Visible: false;
      Anchor: (Height: 20, Top: 6);
      Style: (FontSize: 12, TextColor: #4aff7f, HorizontalAlignment: Center);
    }
  }
}
