$Z = "../Common/ZigButtons.ui";
$ZK = "../Common/ZigTokens.ui";
$ZX = "../Common/ZigText.ui";

// ── mmo-mob-scaling WORLD LIST ROW (wraps long ids/match patterns) ────────────
// Appended into #MmoscalingWorldList: cmd.append("#MmoscalingWorldList", "Pages/MmoscalingWorldRow.ui");
// then addressed per row via the INDEXED PARENT (e.g. "#MmoscalingWorldList[0] #Title"), so the bare
// descendant ids below are safe across many rows AND across mods (the ZigListRow rule this is modeled
// on). MOD-LOCAL (not ziggfreed-common's Pages/ZigListRow.ui): that shared row is single-line-title and
// truncates a long world id / match pattern in this page's 300px list panel. Here #Title WRAPS to two
// lines instead (no fixed title height; the row itself carries the fixed height), #Sub WRAPS too (a
// floor row's sub line, "<type> <target>, floor <n>", outgrows the text column once the Remove button
// is showing, and a floor id is short enough to leave the row height for it), and
// #Badge/#EditBtn/#RemoveBtn are narrower to leave room for the wider title column. Same
// child ids as ZigListRow, so MobScalingAdminPage.buildWorldList (Java) is unchanged beyond the template
// path: #Title/#Sub text, #Badge/#RemoveBtn Visible, the rich button labels (ZigRichButton.text on
// #EditBtn/#RemoveBtn, which keep $Z.@ZigRichRowBtnStyle for click sounds), and the click bindings.
//
// THE LOOK is ziggfreed-common's: the row sits on the kit's list-row surface, its words are the kit's text
// styles in its inks, the badge reads in the done tone and Remove in the danger tone. It spells no colour.

Group #MmoscalingWorldRow {
  LayoutMode: Left;
  Anchor: (Height: 64, Bottom: 4);
  Padding: (Horizontal: 6, Vertical: 3);
  Background: (Color: $ZK.@ZigSurfaceRow);

  Group #TextCol {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 8);
    Label #Title {
      Text: "";
      Style: (...$ZX.@ZigBodyStyle, TextColor: $ZK.@ZigInkStrong, VerticalAlignment: Start, Wrap: true);
    }
    Label #Sub {
      Text: "";
      Style: (...$ZX.@ZigCaptionStyle, VerticalAlignment: Start, Wrap: true);
    }
  }

  Label #Badge {
    Visible: false;
    Anchor: (Width: 54, Height: 58);
    Text: "";
    Style: (...$ZX.@ZigCaptionStyle, TextColor: $ZK.@ZigToneDoneText, HorizontalAlignment: Center, RenderBold: true);
  }

  Button #EditBtn {
    Style: $Z.@ZigRichRowBtnStyle;
    Anchor: (Width: 56, Height: 30, Left: 6);
    Label #Label {
      FlexWeight: 1;
      Text: "";
      Style: (...$ZX.@ZigCaptionStyle, TextColor: $ZK.@ZigInkStrong, HorizontalAlignment: Center);
    }
  }

  Button #RemoveBtn {
    Visible: false;
    Style: $Z.@ZigRichRowBtnStyle;
    Anchor: (Width: 56, Height: 30, Left: 6);
    Label #Label {
      FlexWeight: 1;
      Text: "";
      Style: (...$ZX.@ZigCaptionStyle, TextColor: $ZK.@ZigToneDangerText, HorizontalAlignment: Center);
    }
  }
}
